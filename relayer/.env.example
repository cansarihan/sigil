# Which Stellar network the relayer sponsors on.
SIGIL_NETWORK=testnet

# The one vault contract this relayer will pay fees for. Requests naming any
# other contract are rejected outright.
SIGIL_VAULT_ID=CB6IEZRJHZ7PAZAUNEEPIWZIBT2YGQ3RV433EPHYWG3CEE657H6K5OSQ

# Secret key of the account that pays the fees. Fund it with only as much XLM
# as you are willing to lose, and never reuse a vault signer key here.
SIGIL_SPONSOR_SECRET=S...

# Optional overrides.
# SIGIL_RPC_URL=https://soroban-testnet.stellar.org
# PORT=8787
# SIGIL_MAX_INNER_FEE=2000000     # per-transaction ceiling, stroops
# SIGIL_FEE_BUMP_FEE=200000       # outer envelope bid, stroops
# SIGIL_DAILY_BUDGET=50000000     # 5 XLM/day of fees
# SIGIL_PER_ACCOUNT_RATE=10       # sponsored txs per account per minute
